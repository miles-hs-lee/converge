NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_USE_MOCK=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional but recommended: dedicated encryption key for OAuth tokens at rest.
# If omitted, the app derives a key from SUPABASE_SERVICE_ROLE_KEY.
OAUTH_SECRETS_ENCRYPTION_KEY=

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
AZURE_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Product analytics (PostHog)
POSTHOG_API_KEY=
# Optional (default: https://us.i.posthog.com, use https://eu.i.posthog.com for EU)
POSTHOG_HOST=

# Error monitoring (Sentry)
# Browser DSN (public)
NEXT_PUBLIC_SENTRY_DSN=
# Server DSN (optional; falls back to NEXT_PUBLIC_SENTRY_DSN)
SENTRY_DSN=
# Runtime sample rates (0.0 - 1.0)
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_TRACES_SAMPLE_RATE=0.1
# Release/source map upload (build-time; set in Vercel)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_TUNNEL_ROUTE=/monitoring
# Optional: enable backend Sentry smoke-test API (/api/observability/sentry-test)
SENTRY_ENABLE_TEST_ENDPOINT=false

# Web Push (Background notifications)
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: protect cron endpoints (if you add a scheduler)
CRON_SECRET=

# Optional: calendar auto-sync threshold on /calendar page entry (minutes, default 3)
CALENDAR_AUTO_SYNC_STALE_MINUTES=3

# Optional: cap Microsoft delta pages per calendar for entry sync (default 40)
CALENDAR_ENTRY_SYNC_MAX_DELTA_PAGES=40

# Optional: sync/query window for calendar data (defaults: lookback 14 days, lookahead 60 days)
CALENDAR_LOOKBACK_DAYS=14
CALENDAR_LOOKAHEAD_DAYS=60
